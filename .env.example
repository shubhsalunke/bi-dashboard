# ==============================================================================
# Business Intelligence Application - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
# Comma-separated allowed browser origins in production (e.g. http://localhost:5173,http://<server-ip>:5173)
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_intelligence
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Read-Only Database Role (Used by dynamic AI SQL executor)
AI_DB_USER=ai_readonly
AI_DB_PASSWORD=ai_readonly_password

# JWT Authentication (REQUIRED strong unique secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# Rate Limiting & Login Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
LOGIN_RATE_LIMIT_MAX=20
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AI_RATE_LIMIT_MAX=30

# Optional SMTP Configuration (if configured, Forgot Password sends email reset links)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI Provider Configuration (Gemini, OpenAI, or Mock)
# Supported options: 'mock', 'gemini', 'openai'
AI_PROVIDER=mock
AI_DYNAMIC_SQL=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_SQL_TIMEOUT_MS=30000

# Client Configuration (Frontend Vite relative proxy)
VITE_API_URL=/api
# Show Demo Account quick-fill buttons on /login (default false in production builds)
VITE_SHOW_DEMO_ACCOUNTS=false
