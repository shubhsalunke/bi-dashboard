# ==============================================================================
# Business Intelligence Application - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_intelligence
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Read-Only Database User (Used for AI Reporting operations)
DB_READONLY_USER=bi_readonly
DB_READONLY_PASSWORD=your_bi_readonly_password_here

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Provider Configuration (Gemini or OpenAI)
# Supported options: 'mock', 'gemini', 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# Client Configuration (Frontend)
VITE_API_URL=http://localhost:5000/api
